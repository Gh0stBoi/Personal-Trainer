<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data extraction rules.
    Cloud backup: include database, exclude encrypted prefs.
    Device-to-device transfer: include database.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="personal_trainer.db" />
        <exclude domain="sharedpref" path="encrypted_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="personal_trainer.db" />
    </device-transfer>
</data-extraction-rules>
